# =====================================================================
# MULTI-AI TEAM — .env (BOS SABLON, GitHub icin guvenli)
# =====================================================================
# GitHub Repo:  https://github.com/Sansar35/claude-agent  (public)
# Klone:        git clone https://github.com/Sansar35/claude-agent.git
#
# Lider:  Claude Opus 4.7  (Claude Max ABONELIK ile, KEY GEREKMEZ)
# Worker: Diger AI'lar     (asagidaki key'lerle)
#
# === GERCEK KEY'LERINI NEREYE YAZMALI? ===
# 1) `.env.local` dosyasi olustur (ayni klasorde)
# 2) Asagidaki key'leri ORAYA yapistir
# 3) team.py once .env'i (bu dosya) sonra .env.local'i okur — local override eder
# 4) .env.local .gitignore'da → ASLA git'e gitmez (guvenli)
#
# Hicbir key zorunlu degil — hangisini doldurursan o ajan ekibe katilir.
# Hicbiri girilmezse sadece Claude (Opus/Sonnet/Haiku) calisir.
# Litellm 100+ provider destekler — hepsi destekleniyor.
# =====================================================================

# ============= ONERILEN: OPENROUTER (TEK KEY = 300+ MODEL) =============
# https://openrouter.ai/keys
# Bu key girilirse: GPT-5, Gemini 2.5, DeepSeek, Llama 3.3, Qwen, Mistral, Grok
# hepsi otomatik devreye girer (en pratik secenek).
OPENROUTER_API_KEY=

# ============= DIREKT PROVIDERLAR (opsiyonel — daha ucuz/hizli) =============
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
DEEPINFRA_API_KEY=
NVIDIA_API_KEY=
HYPERBOLIC_API_KEY=
SAMBANOVA_API_KEY=

# ============= EK PREMIUM SAGLAYICILAR =============
# Azure OpenAI Service
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock (Claude/Llama/Mistral/Cohere/Titan)
AWS_BEDROCK_ACCESS_KEY=
AWS_BEDROCK_SECRET_KEY=
AWS_REGION=us-east-1

# Google Vertex AI (Gemini, Claude on Vertex, Llama)
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1

# IBM WatsonX (Granite, Llama, Mistral)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Databricks (Llama, DBRX, Claude)
DATABRICKS_API_KEY=
DATABRICKS_HOST=

# Snowflake Cortex
SNOWFLAKE_API_KEY=

# Vercel AI Gateway (multi-provider birlestirme)
VERCEL_AI_GATEWAY_KEY=

# ============= ACIK-KAYNAK HOST PROVIDERLAR =============
# Replicate (Llama, Stable Diffusion, FLUX, MusicGen)
REPLICATE_API_TOKEN=

# AnyScale (Llama, Mistral, CodeLlama)
ANYSCALE_API_KEY=

# Baseten (open-source model serving)
BASETEN_API_KEY=

# OctoAI / OctoML (open-source endpoint)
OCTOAI_API_KEY=

# Lepton AI
LEPTON_API_KEY=

# SiliconFlow (DeepSeek, Qwen, Llama Chinese cloud)
SILICONFLOW_API_KEY=

# Novita AI (open-source endpoint)
NOVITA_API_KEY=

# Kluster AI (Llama)
KLUSTER_API_KEY=

# Lambda Labs (Llama, Hermes, Nemotron)
LAMBDALABS_API_KEY=

# Targon (open-source)
TARGON_API_KEY=

# Latitude AI (open-source)
LATITUDE_API_KEY=

# Inference.net
INFERENCE_NET_API_KEY=

# Friendli AI
FRIENDLI_API_KEY=

# Aimlapi (multi-provider proxy)
AIMLAPI_API_KEY=

# NScale (open-source)
NSCALE_API_KEY=

# GooseAI
GOOSEAI_API_KEY=

# NetMind AI
NETMIND_API_KEY=

# Featherless AI
FEATHERLESS_API_KEY=

# ============= OZEL / NICHE SAGLAYICILAR =============
# AI21 Labs (Jamba, Jurassic)
AI21_API_KEY=

# Aleph Alpha (Luminous)
ALEPH_ALPHA_API_KEY=

# Inflection AI (Pi)
INFLECTION_API_KEY=

# Writer (Palmyra)
WRITER_API_KEY=

# Character.AI
CHARACTER_AI_KEY=

# NLPCloud
NLPCLOUD_API_KEY=

# Voyage AI (embeddings + reranker)
VOYAGE_API_KEY=

# Jina AI (embeddings + reranker + reader)
JINA_API_KEY=

# BAAI (BGE embeddings)
BAAI_API_KEY=

# ============= LIDER MODEL OVERRIDE (opsiyonel) =============
# Default: claude-opus-4-7 (degistirme tavsiye edilmez)
LEAD_MODEL=claude-opus-4-7

